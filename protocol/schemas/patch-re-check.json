{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cairnfield:schema:1:patch-re-check",
  "type": "object",
  "properties": {
    "version": {
      "const": "1"
    },
    "type": {
      "const": "patch-re-check"
    },
    "component": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "patch": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "resolves",
        "does-not-resolve",
        "does-more"
      ]
    },
    "model": {
      "enum": [
        "claude-sonnet-5-5",
        "claude-haiku-4-5-20251001",
        "other",
        "none"
      ]
    }
  },
  "required": [
    "version",
    "type",
    "component",
    "patch",
    "verdict",
    "model"
  ],
  "additionalProperties": false
}
