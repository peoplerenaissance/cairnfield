{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Cloudflare Artifacts repo token",
            "pattern": "/art_v[0-9]+_[0-9a-f]{32,}/"
          },
          {
            "name": "Anthropic API key",
            "pattern": "/sk-ant-[A-Za-z0-9_-]{20,}/"
          }
        ]
      }
    }
  ]
}
