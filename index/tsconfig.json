{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022", "esnext.disposable"],
    // The module `cloudflare:test`. The runtime and binding types come from the file
    // that `wrangler types` writes, which `npm run typecheck` regenerates.
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src", "test", "worker-configuration.d.ts"],
  // The page's script and the map it draws run in a browser. `src/page/tsconfig.json`
  // checks them there, with `render.ts`, which the tests also call in the Workers runtime.
  "exclude": ["src/page/poll.ts", "src/page/map.ts"]
}
