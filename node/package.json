{
  "name": "cairnfield-node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cairnfield team node: a Cloudflare Worker that holds a team's repos on Artifacts and serves the node contract.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "npm run types && tsc -p tsconfig.json",
    "check": "wrangler deploy --dry-run --env=\"\" && wrangler deploy --dry-run --env team-a && wrangler deploy --dry-run --env team-b",
    "deploy": "wrangler deploy --env=\"\" --var NODE_URL:${NODE_URL:-} --var INDEX_URL:${INDEX_URL:-}",
    "deploy:team-a": "wrangler deploy --env team-a --var NODE_URL:${TEAM_A_NODE_URL:-} --var INDEX_URL:${INDEX_URL:-}",
    "deploy:team-b": "wrangler deploy --env team-b --var NODE_URL:${TEAM_B_NODE_URL:-} --var INDEX_URL:${INDEX_URL:-}",
    "deploy:demo": "npm run deploy:team-a && npm run deploy:team-b"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "miniflare@5.20260815.0-alpha": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    },
    "miniflare@5.20261001.0-alpha": {
      "sharp": "0.35.5"
    }
  }
}
